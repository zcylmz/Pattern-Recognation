function [ value ] = comp_gauss_dens_val( m, S, x )
    l = length(m);
    exp_component = (x - m).'*inv(S)*(x - m);
    value = 1/(((2*pi)^(l/2))*(det(S)^(1/2)))*exp(-1/2*exp_component);
    
end


